# Exec steht in Anfuehrungszeichen: Liegt das Projekt in einem Ordner mit
# Leerzeichen im Namen, startet es sonst gar nicht.
[Desktop Entry]
Version=1.0
Type=Application
Name=Schreibhilfe (eigenes Fenster)
GenericName=Rechtschreibhilfe
Comment=Dieselbe App wie auf dem Handy — als eigenes Fenster, ohne Browser
Exec="ORDNER/linux/schreibhilfe.py"
Icon=ORDNER/online/icon-512.png
StartupWMClass=schreibhilfe
Terminal=false
Categories=Office;Utility;
Keywords=Rechtschreibung;Korrektur;Legasthenie;Schreiben;Ollama;
StartupNotify=true
