<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ein Menüklick in LibreOffice verschickt einen Befehl wie
  „de.schreibhilfe.befehl:korrigieren“. Hier steht, wer solche Befehle
  entgegennimmt: unsere Python-Komponente.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="ProtocolHandler"
                    oor:package="org.openoffice.Office">
  <node oor:name="HandlerSet">
    <node oor:name="de.schreibhilfe.Handler" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>de.schreibhilfe.befehl:*</value>
      </prop>
    </node>
  </node>
</oor:component-data>
