<?xml version="1.0" encoding="UTF-8"?>
<manifest:manifest xmlns:manifest="http://openoffice.org/2001/manifest">

  <!-- Der Python-Teil: eine UNO-Komponente, die die Menübefehle entgegennimmt. -->
  <manifest:file-entry
      manifest:media-type="application/vnd.sun.star.uno-component;type=Python"
      manifest:full-path="schreibhilfe.py"/>

  <!-- Meldet den Befehlsraum „de.schreibhilfe.befehl:…“ an. Ohne das kommt
       ein Menüklick nirgendwo an. -->
  <manifest:file-entry
      manifest:media-type="application/vnd.sun.star.configuration-data"
      manifest:full-path="ProtocolHandler.xcu"/>

  <!-- Das Menü selbst. -->
  <manifest:file-entry
      manifest:media-type="application/vnd.sun.star.configuration-data"
      manifest:full-path="Addons.xcu"/>

  <!-- Die Tafel baut ihre Oberfläche selbst — auch sie ist eine Komponente. -->
  <manifest:file-entry
      manifest:media-type="application/vnd.sun.star.uno-component;type=Python"
      manifest:full-path="tafel.py"/>

  <!-- Wer die Tafel baut. -->
  <manifest:file-entry
      manifest:media-type="application/vnd.sun.star.configuration-data"
      manifest:full-path="Factories.xcu"/>

  <!-- Die Tafel in der Seitenleiste. -->
  <manifest:file-entry
      manifest:media-type="application/vnd.sun.star.configuration-data"
      manifest:full-path="Sidebar.xcu"/>

</manifest:manifest>
