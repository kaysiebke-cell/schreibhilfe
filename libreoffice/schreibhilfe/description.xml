<?xml version="1.0" encoding="UTF-8"?>
<description xmlns="http://openoffice.org/extensions/description/2006"
             xmlns:d="http://openoffice.org/extensions/description/2006"
             xmlns:lo="http://libreoffice.org/extensions/description/2011"
             xmlns:xlink="http://www.w3.org/1999/xlink">

  <identifier value="de.schreibhilfe.writer"/>
  <version value="1.0.0"/>

  <display-name>
    <name lang="de">Schreibhilfe</name>
    <name lang="en">Schreibhilfe</name>
  </display-name>

  <extension-description>
    <src lang="de" xlink:href="beschreibung.txt"/>
  </extension-description>

  <!-- Die Erweiterung ist reines Python und läuft überall, wo LibreOffice
       läuft. Ab 6.0, weil erst dort Python 3 mitgeliefert wird.

       Wichtig ist die LibreOffice-eigene Angabe: LibreOffice meldet sich
       gegenüber „OpenOffice.org-minimal-version“ bis heute als 4.1, eine
       Forderung nach 6.0 dort scheitert also immer — mit der wenig
       hilfreichen Meldung „unsatisfied dependencies“. -->
  <dependencies>
    <lo:LibreOffice-minimal-version value="6.0" d:name="LibreOffice 6.0"/>
  </dependencies>

  <publisher>
    <name xlink:href="https://github.com/kaysiebke-cell/schreibhilfe" lang="de">Schreibhilfe</name>
  </publisher>

</description>
