<?xml version="1.0" encoding="UTF-8"?>
<!--
  Wer baut die Tafel? Die Seitenleiste kennt nur eine Adresse
  („private:resource/toolpanel/…“) und sucht hier nach, welche Komponente sich
  dafür zuständig gemeldet hat.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Factories" oor:package="org.openoffice.Office.UI">
  <node oor:name="Registered">
    <node oor:name="private:resource/toolpanel/de.schreibhilfe.Fabrik"
          oor:op="replace">
      <prop oor:name="Type" oor:type="xs:string"><value>toolpanel</value></prop>
      <prop oor:name="Name" oor:type="xs:string"><value>de.schreibhilfe.Fabrik</value></prop>
      <prop oor:name="Module" oor:type="xs:string"><value></value></prop>
      <prop oor:name="FactoryImplementation" oor:type="xs:string">
        <value>de.schreibhilfe.Fabrik</value>
      </prop>
    </node>
  </node>
</oor:component-data>
