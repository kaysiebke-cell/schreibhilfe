<?xml version="1.0" encoding="UTF-8"?>
<!--
  Die eigene Tafel in der Seitenleiste von Writer — angedockt am Rand statt als
  frei schwebendes Fenster, so wie die Kästen in der App unter dem Text stehen.

  Der Aufbau ist vorgegeben: alles hängt unter „Content“, die Bereiche unter
  „DeckList“, die Tafeln darin unter „PanelList“. Ein Deck ohne diese Hülle
  wird stillschweigend übergangen — die Tafel taucht dann einfach nie auf.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">

    <node oor:name="DeckList">
      <node oor:name="SchreibhilfeDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="de">Schreibhilfe</value>
          <value xml:lang="en-US">Schreibhilfe</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string"><value>SchreibhilfeDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string">
          <value>private:graphicrepository/cmd/sc_spelldialog.png</value>
        </prop>
        <prop oor:name="HighContrastIconURL" oor:type="xs:string">
          <value>private:graphicrepository/cmd/sc_spelldialog.png</value>
        </prop>
        <prop oor:name="ContextList" oor:type="oor:string-list">
          <value>WriterVariants, any, visible ;</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>10</value></prop>
      </node>
    </node>

    <node oor:name="PanelList">
      <node oor:name="SchreibhilfeTafel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="de">Prüfen</value>
          <value xml:lang="en-US">Check</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string"><value>SchreibhilfeTafel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>SchreibhilfeDeck</value></prop>
        <prop oor:name="ContextList" oor:type="oor:string-list">
          <value>WriterVariants, any, visible ;</value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string">
          <value>private:resource/toolpanel/de.schreibhilfe.Fabrik/Tafel</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>10</value></prop>
      </node>
    </node>

  </node>
</oor:component-data>
