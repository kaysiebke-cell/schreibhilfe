<?xml version="1.0" encoding="utf-8"?>
<!-- Angaben für den Bedienungshilfe-Dienst.
     canRetrieveWindowContent: nötig, um den Text im Feld zu lesen und zu ersetzen.
     flagRetrieveInteractiveWindows: findet den Fokus auch in geteilten Fenstern. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:description="@string/dienst_beschreibung"
    android:summary="@string/dienst_kurz" />
