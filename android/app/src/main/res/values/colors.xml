         gezeichnet hat — sonst blitzte beim Start die alte Farbe auf. -->
    <color name="paper">#F4F5F7</color>
    <color name="paper_raised">#F4F5F7</color>
    <color name="petrol">#2F6FD0</color>
    <color name="petrol_deep">#24589F</color>

    <!-- Rückmeldung des Schwebeknopfs: kurz aufblinken statt nur ein Toast. -->
    <color name="knopf_gut">#2E7D57</color>
    <color name="knopf_nichts">#626A73</color>
    <color name="knopf_fehler">#C0392B</color>
